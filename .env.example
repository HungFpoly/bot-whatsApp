# ===========================================
# WhatsApp Moderation Bot - Environment Config
# ===========================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI Model
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Group ID (will be set after bot connects)
# Format: xxxxxxxxxx@g.us
WHATSAPP_GROUP_ID=

# Bot Behavior
# Minimum message length to trigger AI analysis (skip short messages like "ok", "thanks")
MIN_MESSAGE_LENGTH=5

# Action when violation detected: "delete" or "delete_and_warn"
VIOLATION_ACTION=delete

# Warning message sent to user after deletion (if VIOLATION_ACTION=delete_and_warn)
WARNING_MESSAGE=Your message was removed for violating group rules.

# Server Port (for health check endpoint)
PORT=3000

# Node Environment
NODE_ENV=production
