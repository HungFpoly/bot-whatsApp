# WhatsApp Moderation Bot
# Copy this file to .env and replace the placeholder values.

# OpenAI API
# Create an API key at https://platform.openai.com/api-keys
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# WhatsApp
# Optional: restrict moderation and onboarding to one group.
# Group ID format: 1234567890-1234567890@g.us
WHATSAPP_GROUP_ID=

# Directory used to persist the WhatsApp login session.
WHATSAPP_SESSION_PATH=./session

# Optional: use a pairing code instead of scanning a QR code.
# Digits only, including country code; for example: 6591234567
WHATSAPP_PHONE_NUMBER=

# Admin number notified during onboarding unit verification.
# Digits only, including country code; for example: 6591234567
ADMIN_WHATSAPP_NUMBER=

# Moderation
# Messages shorter than this value skip text moderation.
MIN_MESSAGE_LENGTH=5

# Supported values: delete, delete_and_warn
VIOLATION_ACTION=delete
WARNING_MESSAGE=Your message was removed for violating group rules.

# Quiet hours
# Set to false to disable quiet-hours reminders.
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=23
QUIET_HOURS_END=7
QUIET_HOURS_TIMEZONE=Asia/Singapore
QUIET_HOURS_MESSAGE=Quiet hours are from 11 pm to 7 am. Please be mindful when posting during this time.

# Google Sheets (used for onboarding records and deleted-message logs)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account.json

# Health-check server
PORT=3000
